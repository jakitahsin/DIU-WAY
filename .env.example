# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: public URL of the deployed site, used in auth emails.
# Leave empty locally; on Vercel set it to e.g. https://diu-way.vercel.app
NEXT_PUBLIC_SITE_URL=

# NEVER add the service_role / secret key here. This app does not need it.
